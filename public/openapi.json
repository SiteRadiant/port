{
  "openapi": "3.0.0",
  "info": {
    "title": "SiteRadiant Public API",
    "description": "Public API for SiteRadiant services. SiteRadiant offers custom website development.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://siteradiant.co.in/api/v1"
    }
  ],
  "paths": {
    "/services": {
      "get": {
        "operationId": "getServices",
        "summary": "List available services",
        "description": "Returns a list of services offered by SiteRadiant.",
        "responses": {
          "200": {
            "description": "A list of services",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Service"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Service": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    }
  }
}
